{
  "manifest_version": 3,
  "name": "PS26171 Privacy Browser Agent",
  "version": "1.0.0",
  "description": "On-device Visual Perception for Light-weight Browser Agents (ISRO PS 26171)",
  "browser_specific_settings": {
    "gecko": {
      "id": "visiionary-agent@ps26171.isro",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "sidebar_action": {
    "default_panel": "src/ui/sidepanel.html",
    "default_title": "PS26171 Agent",
    "default_icon": "icons/icon32.png"
  },
  "background": {
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PS26171 Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "public/*",
        "public/ort/*",
        "public/models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
